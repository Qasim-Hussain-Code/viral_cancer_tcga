# Git LFS tracking for dataset binaries and large matrices
*.rds filter=lfs diff=lfs merge=lfs -text
*.RData filter=lfs diff=lfs merge=lfs -text
*.rda filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# Exclude generated HTML reports and figures from language stats
TCGA_Viral_Etiology_Analysis.html linguist-detectable=false
iframe_figures/** linguist-generated=true
iframe_figures/** linguist-documentation=true
figures/** linguist-generated=true
**/*.html linguist-detectable=false

# Explicitly map R Markdown files to R
*.Rmd linguist-language=R
*.R linguist-language=R
